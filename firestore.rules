rules_version = '2';

// Blockwire accounts (CLAUDE.md §7 Stage 1.4):
//   username    — private, immutable once set.
//   displayName — the ONLY public field, rate-limited to one change/week.
//   email/password live in Firebase Auth itself, never duplicated here.
//
// Split into two docs per user (private vs public) because Firestore rules
// can't restrict individual fields within one document — only whole docs.
//
//   /users/{uid}        — private: { username, createdAt }.        owner-only read.
//   /profiles/{uid}      — public:  { displayName, lastDisplayNameChangeAt }. anyone can read.
//   /usernames/{lower}   — reservation doc enforcing username uniqueness: { uid }.
//                          doc id IS the lowercased username; anyone can read
//                          (client-side "is this taken?" check), but it can only
//                          ever be created once (first write wins) and only by
//                          a uid that doesn't already own a /users/{uid} doc —
//                          one username per account. Create it together with
//                          /users/{uid} in the same batch/transaction at signup.
//
// Device linking (Stage 1.4 "app linking"): the desktop app has no Firebase Auth
// session of its own, so it can't create/own docs. The WEBSITE (already signed
// in) creates a short-lived pairing code; the app reads it and flips it from
// pending -> linked, both unauthenticated, to pull down { uid, ... } and store a
// local "linked account" record. See /linkCodes below for the exact contract.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.username.matches('^[a-zA-Z0-9_]+$')
        && request.resource.data.createdAt == request.time;
      // Username is immutable once set — no client update/delete.
      allow update, delete: if false;
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'lastDisplayNameChangeAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 3
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.lastDisplayNameChangeAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'lastDisplayNameChangeAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 3
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.lastDisplayNameChangeAt == request.time
        // Rate limit: once every 7 days.
        && request.time > resource.data.lastDisplayNameChangeAt + duration.value(7, 'd');
      allow delete: if false;
    }

    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && usernameLower == usernameLower.lower()
        // One username per account — can't already have a /users/{uid} doc.
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update, delete: if false;
    }

    // Device-linking pairing codes. Doc id is the code itself.
    match /linkCodes/{code} {
      // Readable by anyone: the unauthenticated desktop app needs to read it
      // to discover the uid once linked. Contents are low-sensitivity (a uid
      // + short-lived status) — not a secret in themselves, the CODE is what's
      // secret (shown only to the signed-in user who generated it).
      allow read: if true;
      // Only the website (authenticated) can mint a code, for itself. expiresAt
      // is checked as a RANGE, not exact equality — the client can't predict
      // the server's exact request.time ahead of the write, so it just needs
      // to land within a sane window (up to 11 minutes out, for ~1min slack).
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'status', 'createdAt', 'expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(11, 'm');
      // Only transition allowed, by anyone (the unauthenticated app): flip
      // pending -> linked, nothing else, and only before it expires. This is
      // the one narrow write the app can make without ever having its own
      // Firebase Auth session.
      allow update: if resource.data.status == 'pending'
        && request.time < resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'linked';
      // The website owner can cancel their own pending code.
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Everything else: closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
